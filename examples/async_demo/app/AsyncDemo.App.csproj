<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../dotnet/WinRT.RustComponent.Build/build/WinRT.RustComponent.Build.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AsyncDemo.App</AssemblyName>
    <RootNamespace>AsyncDemo.App</RootNamespace>
    <Optimize>true</Optimize>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <WinRTConsumeInterop>true</WinRTConsumeInterop>
    <WinRTCargoManifest>../rust/Cargo.toml</WinRTCargoManifest>
    <WinRTAutoBuildCargo>true</WinRTAutoBuildCargo>
  </PropertyGroup>

  <ItemGroup>
    <WinRTComponent Include="AsyncDemo">
      <WinMD>../rust/target/winmd/AsyncDemo.winmd</WinMD>
      <RefAssembly>../projection/bin/$(Configuration)/net10.0/ref/AsyncDemo.Projection.dll</RefAssembly>
      <ForwarderAssembly>../projection/bin/$(Configuration)/net10.0/AsyncDemo.Projection.dll</ForwarderAssembly>
    </WinRTComponent>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../projection/AsyncDemo.Projection.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      ExcludeAssets="all" />
    <ProjectReference Include="../../../dotnet/WinRT.CrossHosting/WinRT.CrossHosting.csproj" />
  </ItemGroup>

  <Import Project="../../../dotnet/WinRT.RustComponent.Build/build/WinRT.RustComponent.Build.targets" />
</Project>
