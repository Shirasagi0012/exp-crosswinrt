<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../dotnet/WinRT.RustComponent.Build/build/WinRT.RustComponent.Build.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AsyncDemo.Projection</AssemblyName>
    <RootNamespace>AsyncDemo</RootNamespace>
    <Nullable>enable</Nullable>
    <WinRTProjection>true</WinRTProjection>
    <WinRTContractWinMD>../rust/target/winmd/AsyncDemo.winmd</WinRTContractWinMD>
    <WinRTCargoManifest>../rust/Cargo.toml</WinRTCargoManifest>
    <WinRTAutoBuildCargo>true</WinRTAutoBuildCargo>
    <WinRTCopyNativeLibrary>false</WinRTCopyNativeLibrary>
  </PropertyGroup>

  <Import Project="../../../dotnet/WinRT.RustComponent.Build/build/WinRT.RustComponent.Build.targets" />
</Project>
